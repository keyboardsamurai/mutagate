{
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node .github/s16/probe.cjs sessionStart copilot-settings || true",
        "timeoutSec": 30
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "node .github/s16/probe.cjs sessionEnd copilot-settings || true",
        "timeoutSec": 30
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "node .github/s16/probe.cjs userPromptSubmitted copilot-settings || true",
        "timeoutSec": 30
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "node .github/s16/probe.cjs preToolUse copilot-settings || true",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "node .github/s16/probe.cjs postToolUse copilot-settings || true",
        "timeoutSec": 30
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "bash": "node .github/s16/probe.cjs postToolUseFailure copilot-settings || true",
        "timeoutSec": 30
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "node .github/s16/probe.cjs agentStop copilot-settings || true",
        "timeoutSec": 30
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": "node .github/s16/probe.cjs subagentStart copilot-settings || true",
        "timeoutSec": 30
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "node .github/s16/probe.cjs subagentStop copilot-settings || true",
        "timeoutSec": 30
      }
    ]
  }
}
