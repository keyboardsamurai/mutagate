{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .github/s16/probe.cjs SessionStart claude-settings || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .github/s16/probe.cjs PreToolUse claude-settings || true"
          }
